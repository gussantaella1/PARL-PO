#!/usr/bin/env bash
#
# Parallel scalar launcher for thesis-priority KF Monte Carlo suites: 20 m and
# 100 m. This intentionally keeps evaluate_policy.py behavior unchanged; it only
# runs independent output folders concurrently.
set -euo pipefail

cd "$(dirname "$0")"
source ./run_eval_sequence_lib.sh

SCRIPT_NAME="${RUN_EVAL_SCRIPT_NAME:-$(basename "$0")}"
PARALLEL_JOBS="${PARALLEL_JOBS:-2}"
DISPERSIONS_MODULE="${DISPERSIONS_MODULE:-dispersions}"
OUT_DIR_TAG="${OUT_DIR_TAG-}"
LOG_ROOT="${LOG_ROOT:-logs/kf_priority_parallel_$(date +%Y%m%d_%H%M%S)}"

DEFAULT_RUN_SPECS=(
  "Training_Policy_0.1u_1vmax_0.05_icVmax_KF_ON:hcw"
  "Training_Policy_2.0u_1vmax_1.0_icVmax_KF_ON:hcw"
  "Training_Policy_0.5u_1.5vmax_1.0_icVmax_KF_ON:hcw"
  "Training_Policy_0.1u_1vmax_0.05_icVmax_KF_ON:elliptic_ltv"
  "Training_Policy_2.0u_1vmax_1.0_icVmax_KF_ON:elliptic_ltv"
  "Training_Policy_0.5u_1.5vmax_1.0_icVmax_KF_ON:elliptic_ltv"
)

MATCHUPS=(
  "def0_vs_att1:def0_teacher.pt:att1_teacher.pt"
  "def1_vs_att1:def1_teacher.pt:att1_teacher.pt"
  "def1_vs_att2:def1_teacher.pt:att2_teacher.pt"
  "def2_vs_att2:def2_teacher.pt:att2_teacher.pt"
)

case_completed() {
  local out_dir="$1"

  if [[ "${FORCE_RERUN:-false}" == "true" || "${FORCE_RERUN:-0}" == "1" ]]; then
    return 1
  fi
  [[ -s "${out_dir}/results.json" && -s "${out_dir}/trials.csv" ]]
}

suite_out_root() {
  local suite="$1"
  local effective_dynamics="$2"
  local base=""
  local dyn_suffix=""

  case "${suite}" in
    20m) base="MC_eval_20m" ;;
    100m) base="MC_eval_100m" ;;
    *)
      echo "[${SCRIPT_NAME}] Unknown suite: ${suite}" >&2
      return 1
      ;;
  esac

  dyn_suffix="$(auto_suffix_for_dynamics "${effective_dynamics}")"
  printf '%s%s%s\n' "${base}" "${OUT_DIR_TAG}" "${dyn_suffix}"
}

build_common_args() {
  local suite="$1"
  local effective_dynamics="$2"
  local -n out_args_ref="$3"

  out_args_ref=(
    --auto_shell_grid
    --grid_mode cartesian
    --index 15000
    --shell_fracs 0.2,0.4,0.6,0.8
    --steps 6000
    --points_per_shell 40
    --velocity_controller_enabled true
    --advantage_scale 1.0
    --save_rollout_error_cases
    --device cuda
    --use_kf true
    --dispersions_module "${DISPERSIONS_MODULE}"
  )

  case "${suite}" in
    20m) out_args_ref+=(--arena_radius 20.0) ;;
    100m) out_args_ref+=(--arena_radius 100.0) ;;
  esac

  if [[ -n "${effective_dynamics}" ]]; then
    out_args_ref+=(--dynamics "${effective_dynamics}")
  fi
}

safe_name() {
  printf '%s\n' "$1" | tr '/: ' '___'
}

run_case() {
  local suite="$1"
  local run_dir="$2"
  local effective_dynamics="$3"
  local matchup="$4"
  local case_name def_ckpt att_ckpt out_root out_dir log_name
  local common_args=()

  IFS=: read -r case_name def_ckpt att_ckpt <<< "${matchup}"
  out_root="$(suite_out_root "${suite}" "${effective_dynamics}")"
  out_dir="${run_dir}/${out_root}/${case_name}"

  if case_completed "${out_dir}"; then
    echo "[${SCRIPT_NAME}] Skipping ${suite} ${run_dir} :: ${case_name}; existing results found."
    return 0
  fi

  build_common_args "${suite}" "${effective_dynamics}" common_args
  log_name="$(safe_name "${run_dir}_${out_root}_${case_name}").log"

  echo "[${SCRIPT_NAME}] Starting ${suite} ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --att_ckpt_path "${run_dir}/${att_ckpt}" \
    --out_dir "${out_dir}" \
    "${common_args[@]}" \
    2>&1 | tee "${LOG_ROOT}/${log_name}"
}

wait_for_slot() {
  while (( $(jobs -pr | wc -l) >= PARALLEL_JOBS )); do
    wait -n
  done
}

if ! [[ "${PARALLEL_JOBS}" =~ ^[0-9]+$ ]] || (( PARALLEL_JOBS < 1 )); then
  echo "[${SCRIPT_NAME}] PARALLEL_JOBS must be a positive integer, got '${PARALLEL_JOBS}'." >&2
  exit 1
fi

mkdir -p "${LOG_ROOT}"

DYNAMICS_OVERRIDE="$(canonicalize_dyn_name "${DYNAMICS_OVERRIDE:-}")"

if (($# > 0)); then
  RUN_SPECS=("$@")
else
  RUN_SPECS=("${DEFAULT_RUN_SPECS[@]}")
fi

echo "[${SCRIPT_NAME}] PARALLEL_JOBS=${PARALLEL_JOBS}"
echo "[${SCRIPT_NAME}] OUT_DIR_TAG=${OUT_DIR_TAG:-<standard folders>}"
echo "[${SCRIPT_NAME}] DISPERSIONS_MODULE=${DISPERSIONS_MODULE}"
echo "[${SCRIPT_NAME}] LOG_ROOT=${LOG_ROOT}"

for run_spec in "${RUN_SPECS[@]}"; do
  parse_run_spec "${run_spec}" run_dir run_dyn
  effective_dynamics="$(resolve_effective_dynamics "${run_dyn}" "${DYNAMICS_OVERRIDE}" "")"

  for suite in 20m 100m; do
    echo "[${SCRIPT_NAME}] Queueing suite=${suite} ${run_dir} dynamics=$(format_dynamics_label "${effective_dynamics}")"
    for matchup in "${MATCHUPS[@]}"; do
      wait_for_slot
      run_case "${suite}" "${run_dir}" "${effective_dynamics}" "${matchup}" &
    done
  done
done

wait
echo "[${SCRIPT_NAME}] Done"
