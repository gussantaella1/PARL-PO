#!/usr/bin/env bash
#
# Run one or more Monte Carlo evaluation suites for selected policy folders.
#
# Usage:
#   ./run_eval_sequence_all
#   ./run_eval_sequence_all [run_dir[:dynamics] ...]
#   ./run_eval_sequence_all 20m [run_dir[:dynamics] ...]
#   ./run_eval_sequence_all 50m [run_dir[:dynamics] ...]
#   ./run_eval_sequence_all 100m [run_dir[:dynamics] ...]
#   ./run_eval_sequence_all 100m_advantage [run_dir[:dynamics] ...]
#   ./run_eval_sequence_all all [run_dir[:dynamics] ...]
#
# Each run spec can optionally name a dynamics model. The script evaluates the
# standard policy matchups with evaluate_policy.py and writes the selected
# output tree under each run directory.
set -euo pipefail

cd "$(dirname "$0")"
source ./run_eval_sequence_lib.sh

SCRIPT_NAME="${RUN_EVAL_SCRIPT_NAME:-$(basename "$0")}"

DEFAULT_DYNAMICS=(hcw elliptic_ltv)
REQUIRED_POLICY_CKPTS=(
  def0_teacher.pt
  att1_teacher.pt
  def1_teacher.pt
  att2_teacher.pt
  def2_teacher.pt
)

print_usage() {
  cat <<'EOF'
Usage:
  ./run_eval_sequence_all
  ./run_eval_sequence_all [run_dir[:dynamics] ...]
  ./run_eval_sequence_all 20m [run_dir[:dynamics] ...]
  ./run_eval_sequence_all 50m [run_dir[:dynamics] ...]
  ./run_eval_sequence_all 100m [run_dir[:dynamics] ...]
  ./run_eval_sequence_all 100m_advantage [run_dir[:dynamics] ...]
  ./run_eval_sequence_all all [run_dir[:dynamics] ...]

Suite aliases:
  20, 20m
  50, 50m
  100, 100m
  100m_advantage, 100adv, advantage
  all
EOF
}

canonicalize_suite_name() {
  local suite
  suite="$(trim_whitespace "${1:-}")"

  case "${suite}" in
    20|20m)
      printf '%s\n' "20m"
      ;;
    50|50m)
      printf '%s\n' "50m"
      ;;
    100|100m)
      printf '%s\n' "100m"
      ;;
    100m_advantage|100adv|advantage)
      printf '%s\n' "100m_advantage"
      ;;
    all)
      printf '%s\n' "all"
      ;;
    *)
      printf '%s\n' ""
      ;;
  esac
}

populate_default_run_specs() {
  local -n out_specs_ref="$1"
  local run_dir=""
  local dyn=""
  local missing_ckpt=""
  local has_missing=false

  out_specs_ref=()
  for run_dir in Training_Policy*/; do
    [[ -d "${run_dir}" ]] || continue
    run_dir="${run_dir%/}"

    # This is the non-KF launcher. Keep the base-directory sweep scoped to
    # regular top-level policy folders, and avoid known suspect runs.
    if [[ "${run_dir}" == *"_KF_ON"* || "${run_dir}" == *"VERY_SUS"* ]]; then
      continue
    fi

    has_missing=false
    for missing_ckpt in "${REQUIRED_POLICY_CKPTS[@]}"; do
      if [[ ! -f "${run_dir}/${missing_ckpt}" ]]; then
        has_missing=true
        break
      fi
    done
    if [[ "${has_missing}" == "true" ]]; then
      echo "[${SCRIPT_NAME}] Skipping default run ${run_dir}; missing required policy checkpoints." >&2
      continue
    fi

    for dyn in "${DEFAULT_DYNAMICS[@]}"; do
      out_specs_ref+=("${run_dir}:${dyn}")
    done
  done
}

populate_default_queue() {
  local -n out_queue_ref="$1"

  out_queue_ref=()
}

suite_out_root_base() {
  case "$1" in
    20m)
      printf '%s\n' "MC_eval_20m"
      ;;
    50m)
      printf '%s\n' "MC_eval_50m"
      ;;
    100m)
      printf '%s\n' "MC_eval_100m"
      ;;
    100m_advantage)
      printf '%s\n' "MC_eval_100m_with_advantage"
      ;;
    *)
      return 1
      ;;
  esac
}

case_completed_today() {
  local out_dir="$1"
  local today="${TODAY:-$(date +%F)}"

  if [[ "${FORCE_RERUN:-false}" == "true" || "${FORCE_RERUN:-0}" == "1" ]]; then
    return 1
  fi
  if [[ "${SKIP_COMPLETED_TODAY:-true}" == "false" || "${SKIP_COMPLETED_TODAY:-1}" == "0" ]]; then
    return 1
  fi
  [[ -f "${out_dir}/results.json" && -f "${out_dir}/trials.csv" ]] || return 1
  [[ "$(date -r "${out_dir}/results.json" +%F)" == "${today}" ]] || return 1
  [[ "$(date -r "${out_dir}/trials.csv" +%F)" == "${today}" ]] || return 1
  return 0
}

build_common_args_for_suite() {
  local suite="$1"
  local effective_dynamics="$2"
  local -n out_args_ref="$3"

  out_args_ref=(
    --auto_shell_grid
    --grid_mode cartesian
    --index 15000
    --shell_fracs 0.2,0.4,0.6,0.8
    --steps 6000
    --points_per_shell 40
    --velocity_controller_enabled true
    --advantage_scale 1.0
    --save_rollout_error_cases
    --device cuda
    --use_kf false
  )

  case "${suite}" in
    20m)
      out_args_ref+=(--arena_radius 20.0)
      ;;
    50m)
      out_args_ref+=(--arena_radius 50.0)
      ;;
    100m)
      out_args_ref+=(--arena_radius 100.0)
      ;;
    100m_advantage)
      out_args_ref+=(
        --arena_radius 100.0
        --def_shell_radius 20
        --att_shell_radius 100
      )
      ;;
    *)
      echo "[${SCRIPT_NAME}] Unknown suite '${suite}' while building args." >&2
      return 1
      ;;
  esac

  if [[ -n "${effective_dynamics}" ]]; then
    out_args_ref+=(--dynamics "${effective_dynamics}")
  fi
}

run_policy_case() {
  local suite="$1"
  local run_dir="$2"
  local case_name="$3"
  local def_ckpt="$4"
  local att_ckpt="$5"
  local out_root="$6"
  local effective_dynamics="$7"
  local common_args=()
  local out_dir="${run_dir}/${out_root}/${case_name}"

  if case_completed_today "${out_dir}"; then
    echo "[${SCRIPT_NAME}] Skipping suite=${suite} ${run_dir} :: ${case_name}; already completed today."
    return 0
  fi

  build_common_args_for_suite "${suite}" "${effective_dynamics}" common_args

  echo "[${SCRIPT_NAME}] Starting suite=${suite} ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --att_ckpt_path "${run_dir}/${att_ckpt}" \
    --out_dir "${out_dir}" \
    "${common_args[@]}"
}

run_rule_case() {
  local suite="$1"
  local run_dir="$2"
  local case_name="$3"
  local def_ckpt="$4"
  local out_root="$5"
  local effective_dynamics="$6"
  local common_args=()
  local out_dir="${run_dir}/${out_root}/${case_name}"

  if case_completed_today "${out_dir}"; then
    echo "[${SCRIPT_NAME}] Skipping suite=${suite} ${run_dir} :: ${case_name}; already completed today."
    return 0
  fi

  build_common_args_for_suite "${suite}" "${effective_dynamics}" common_args

  echo "[${SCRIPT_NAME}] Starting suite=${suite} ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --policy_role def \
    --opponent_source rule \
    --out_dir "${out_dir}" \
    "${common_args[@]}"
}

run_suite() {
  local suite="$1"
  shift
  local run_specs=("$@")
  local common_args=()
  local common_args_dynamics=""
  local common_args_base=()

  build_common_args_for_suite "${suite}" "" common_args
  common_args_dynamics="$(detect_common_args_dynamics common_args)"
  strip_dynamics_args common_args common_args_base

  if [[ -n "${DYNAMICS_OVERRIDE}" ]]; then
    echo "[${SCRIPT_NAME}] suite=${suite} DYNAMICS_OVERRIDE=${DYNAMICS_OVERRIDE} will override any per-policy dynamics specs"
  fi

  for run_spec in "${run_specs[@]}"; do
    local run_dir=""
    local run_dyn=""
    local effective_dynamics=""
    local out_dir_suffix=""
    local out_root=""

    parse_run_spec "${run_spec}" run_dir run_dyn
    effective_dynamics="$(resolve_effective_dynamics "${run_dyn}" "${DYNAMICS_OVERRIDE}" "${common_args_dynamics}")"

    if [[ -n "${OUT_DIR_SUFFIX}" ]]; then
      out_dir_suffix="${OUT_DIR_SUFFIX}"
    else
      out_dir_suffix="$(auto_suffix_for_dynamics "${effective_dynamics}")"
    fi
    out_root="$(suite_out_root_base "${suite}")${out_dir_suffix}"

    echo "[${SCRIPT_NAME}] Queueing suite=${suite} ${run_dir} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"

    # run_rule_case "${suite}" "${run_dir}" "def0_vs_rule_attacker" "def0_teacher.pt" "${out_root}" "${effective_dynamics}"
    run_policy_case "${suite}" "${run_dir}" "def0_vs_att1" "def0_teacher.pt" "att1_teacher.pt" "${out_root}" "${effective_dynamics}"
    run_policy_case "${suite}" "${run_dir}" "def1_vs_att1" "def1_teacher.pt" "att1_teacher.pt" "${out_root}" "${effective_dynamics}"
    run_policy_case "${suite}" "${run_dir}" "def1_vs_att2" "def1_teacher.pt" "att2_teacher.pt" "${out_root}" "${effective_dynamics}"
    run_policy_case "${suite}" "${run_dir}" "def2_vs_att2" "def2_teacher.pt" "att2_teacher.pt" "${out_root}" "${effective_dynamics}"
  done
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  print_usage
  exit 0
fi

DYNAMICS_OVERRIDE="$(canonicalize_dyn_name "${DYNAMICS_OVERRIDE:-}")"
OUT_DIR_SUFFIX="${OUT_DIR_SUFFIX:-}"

SUITES=()
USER_RUN_SPECS=()
DEFAULT_QUEUE_ITEMS=()
GENERATED_DEFAULT_RUN_SPECS=()

if (($# == 0)); then
  SUITES=(20m 50m 100m 100m_advantage)
  populate_default_queue DEFAULT_QUEUE_ITEMS
else
  SUITE_SELECTOR="$(canonicalize_suite_name "$1")"
  if [[ -n "${SUITE_SELECTOR}" ]]; then
    shift
    if [[ "${SUITE_SELECTOR}" == "all" ]]; then
      SUITES=(20m 50m 100m 100m_advantage)
    else
      SUITES=("${SUITE_SELECTOR}")
    fi
    USER_RUN_SPECS=("$@")
  else
    SUITES=(20m 50m 100m 100m_advantage)
    USER_RUN_SPECS=("$@")
  fi
fi

if ((${#DEFAULT_QUEUE_ITEMS[@]} > 0)); then
  for queue_item in "${DEFAULT_QUEUE_ITEMS[@]}"; do
    suite="${queue_item%%|*}"
    run_spec="${queue_item#*|}"
    run_suite "${suite}" "${run_spec}"
  done
else
  if ((${#USER_RUN_SPECS[@]} == 0)); then
    populate_default_run_specs GENERATED_DEFAULT_RUN_SPECS
  fi
  for suite in "${SUITES[@]}"; do
    RUN_SPECS=()
    if ((${#USER_RUN_SPECS[@]} > 0)); then
      RUN_SPECS=("${USER_RUN_SPECS[@]}")
    else
      RUN_SPECS=("${GENERATED_DEFAULT_RUN_SPECS[@]}")
    fi
    run_suite "${suite}" "${RUN_SPECS[@]}"
  done
fi

echo "[${SCRIPT_NAME}] Done"
