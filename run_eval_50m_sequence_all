#!/usr/bin/env bash
#
# Run the 50 m Monte Carlo evaluation suite for selected policy folders.
#
# Each run spec can optionally name a dynamics model. The script evaluates the
# standard policy matchups with evaluate_policy.py, writes into MC_eval_50m* under
# each run directory, and keeps all per-case arguments centralized in COMMON_ARGS.
set -euo pipefail

cd "$(dirname "$0")"
source ./run_eval_sequence_lib.sh

DEFAULT_RUN_SPECS=(
  # Default queue for this sweep. Passing args to the script replaces this list,
  # which is safer than editing the body for one-off runs.
  # Missing 50m HCW:
  "Failed_Runs/Training_Policy_0.5u_1.5vmax_1.5_icVmax:hcw"
  "Failed_Runs/Training_Policy_0.5u_1vmax_1.0_icVmax:hcw"
  "Training_Policy_2.0u_1.5vmax_1.5_icVmax:hcw"

  # Missing 50m elliptic_ltv:
  "Training_Policy_0.1u_1vmax_0.05_icVmax:elliptic_ltv"
  "Training_Policy_0.5u_1.5vmax_1.0_icVmax:elliptic_ltv"
  "Training_Policy_0.5u_1.5vmax_0.25_icVmax:elliptic_ltv"
  "Failed_Runs/Training_Policy_0.5u_1.5vmax_1.5_icVmax:elliptic_ltv"
  "Failed_Runs/Training_Policy_0.5u_1vmax_1.0_icVmax:elliptic_ltv"
  "Training_Policy_2.0u_1.5vmax_1.5_icVmax:elliptic_ltv"
  "Training_Policy_2.0u_1vmax_1.0_icVmax:elliptic_ltv"
)

if (($# > 0)); then
  RUN_SPECS=("$@")
else
  RUN_SPECS=("${DEFAULT_RUN_SPECS[@]}")
fi

DYNAMICS_OVERRIDE="$(canonicalize_dyn_name "${DYNAMICS_OVERRIDE:-}")"
OUT_DIR_SUFFIX="${OUT_DIR_SUFFIX:-}"

# These are the evaluation knobs that should stay identical across every matchup
# in this distance suite. Per-run dynamics is added later after precedence logic.
COMMON_ARGS=(
  --auto_shell_grid
  --grid_mode cartesian
  --index 15000
  --shell_fracs 0.2,0.4,0.6,0.8
  --arena_radius 50.0
  --velocity_dispersion_std 0.5
  --steps 6000
  --points_per_shell 40
  --velocity_controller_enabled true
  # Use the saved training/default rollout speed cap from run_manifest.json.
  --advantage_scale 1.0
  --save_rollout_error_cases
  # --device cpu
  --device cuda
  --use_kf false
)

COMMON_ARGS_DYNAMICS="$(detect_common_args_dynamics COMMON_ARGS)"
strip_dynamics_args COMMON_ARGS COMMON_ARGS_BASE

build_common_args_for_dynamics() {
  # Rebuild COMMON_ARGS for each run so the same script can mix HCW and
  # elliptic_ltv jobs without duplicating the whole launcher.
  local effective_dynamics="$1"
  local -n out_args_ref="$2"

  out_args_ref=("${COMMON_ARGS_BASE[@]}")
  if [[ -n "${effective_dynamics}" ]]; then
    out_args_ref+=(--dynamics "${effective_dynamics}")
  fi
}

run_policy_case() {
  # Policy-vs-policy case: both checkpoints are loaded from the same run folder.
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"
  local att_ckpt="$4"
  local out_root="$5"
  local effective_dynamics="$6"
  local common_args=()

  build_common_args_for_dynamics "${effective_dynamics}" common_args

  echo "[run_eval_50m_sequence_all] Starting ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --att_ckpt_path "${run_dir}/${att_ckpt}" \
    --out_dir "${run_dir}/${out_root}/${case_name}" \
    "${common_args[@]}"
}

run_rule_case() {
  # Rule-opponent case: useful for sanity checks, left callable even when the
  # default queue focuses on learned attacker checkpoints.
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"
  local out_root="$4"
  local effective_dynamics="$5"
  local common_args=()

  build_common_args_for_dynamics "${effective_dynamics}" common_args

  echo "[run_eval_50m_sequence_all] Starting ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --policy_role def \
    --opponent_source rule \
    --out_dir "${run_dir}/${out_root}/${case_name}" \
    "${common_args[@]}"
}

if [[ -n "${DYNAMICS_OVERRIDE}" ]]; then
  echo "[run_eval_50m_sequence_all] DYNAMICS_OVERRIDE=${DYNAMICS_OVERRIDE} will override any per-policy dynamics specs"
fi

for run_spec in "${RUN_SPECS[@]}"; do
  # Resolve folder, dynamics, and output suffix once, then run the standard
  # matchup set under that exact context.
  parse_run_spec "${run_spec}" run_dir run_dyn
  effective_dynamics="$(resolve_effective_dynamics "${run_dyn}" "${DYNAMICS_OVERRIDE}" "${COMMON_ARGS_DYNAMICS}")"

  if [[ -n "${OUT_DIR_SUFFIX}" ]]; then
    out_dir_suffix="${OUT_DIR_SUFFIX}"
  else
    out_dir_suffix="$(auto_suffix_for_dynamics "${effective_dynamics}")"
  fi
  out_root="MC_eval_50m${out_dir_suffix}"

  echo "[run_eval_50m_sequence_all] Queueing ${run_dir} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"

  # run_rule_case "${run_dir}" "def0_vs_rule_attacker" "def0_teacher.pt" "${out_root}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def0_vs_att1" "def0_teacher.pt" "att1_teacher.pt" "${out_root}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def1_vs_att1" "def1_teacher.pt" "att1_teacher.pt" "${out_root}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def1_vs_att2" "def1_teacher.pt" "att2_teacher.pt" "${out_root}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def2_vs_att2" "def2_teacher.pt" "att2_teacher.pt" "${out_root}" "${effective_dynamics}"
done

echo "[run_eval_50m_sequence_all] Done"
