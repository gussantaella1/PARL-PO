#!/usr/bin/env bash
#
# Run the KF-enabled Monte Carlo evaluation suites across 20 m, 50 m, and 100 m.
#
# This launcher is for already-trained *_KF_ON policy folders. It reuses the same
# policy matchups as the distance-specific scripts, forces --use_kf true, and
# writes one MC_eval_* output tree per arena radius.
set -euo pipefail

cd "$(dirname "$0")"
source ./run_eval_sequence_lib.sh

DEFAULT_RUN_SPECS=(
  # Missing KF-enabled HCW runs across 20m/50m/100m:
  # "Training_Policy_0.5u_1.5vmax_0.25_icVmax_KF_ON:hcw"
  # "Training_Policy_0.5u_1.5vmax_1.0_icVmax_KF_ON:hcw"
  # "Training_Policy_0.5u_1vmax_1.0_icVmax_KF_ON:hcw"

  #Good ones

  # "Training_Policy_2.0u_1.5vmax_1.5_icVmax_KF_ON:hcw"
  # "Training_Policy_2.0u_1vmax_1.0_icVmax_KF_ON:hcw"

  # Elliptic examples are left commented because the current rollout stack
  # disables the estimator for non-HCW dynamics.
  # "Training_Policy_2.0u_1vmax_1.0_icVmax_KF_ON:elliptic_ltv"
  # "Training_Policy_0.5u_1.5vmax_1.0_icVmax_KF_ON:elliptic_ltv"
  "Training_Policy_2.0u_1.5vmax_1.5_icVmax_KF_ON:elliptic_ltv"
  "Training_Policy_2.0u_1vmax_1.0_icVmax_KF_ON:elliptic_ltv"

)

if (($# > 0)); then
  RUN_SPECS=("$@")
else
  RUN_SPECS=("${DEFAULT_RUN_SPECS[@]}")
fi

DYNAMICS_OVERRIDE="$(canonicalize_dyn_name "${DYNAMICS_OVERRIDE:-}")"
OUT_DIR_SUFFIX="${OUT_DIR_SUFFIX:-}"

COMMON_ARGS=(
  --auto_shell_grid
  --grid_mode cartesian
  --index 15000
  --shell_fracs 0.2,0.4,0.6,0.8
  --velocity_dispersion_std 0.5
  --steps 6000
  --points_per_shell 40
  --velocity_controller_enabled true
  # Use the saved training/default rollout speed cap from run_manifest.json.
  --advantage_scale 1.0
  --save_rollout_error_cases
  --device cuda
  --use_kf true
)

COMMON_ARGS_DYNAMICS="$(detect_common_args_dynamics COMMON_ARGS)"
strip_dynamics_args COMMON_ARGS COMMON_ARGS_BASE

build_common_args_for_suite() {
  local arena_radius="$1"
  local effective_dynamics="$2"
  local -n out_args_ref="$3"

  out_args_ref=("${COMMON_ARGS_BASE[@]}")
  out_args_ref+=(--arena_radius "${arena_radius}")
  if [[ -n "${effective_dynamics}" ]]; then
    out_args_ref+=(--dynamics "${effective_dynamics}")
  fi
}

run_policy_case() {
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"
  local att_ckpt="$4"
  local out_root="$5"
  local arena_radius="$6"
  local effective_dynamics="$7"
  local common_args=()

  build_common_args_for_suite "${arena_radius}" "${effective_dynamics}" common_args

  echo "[run_eval_kf_sequence_all] Starting ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --att_ckpt_path "${run_dir}/${att_ckpt}" \
    --out_dir "${run_dir}/${out_root}/${case_name}" \
    "${common_args[@]}"
}

run_rule_case() {
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"
  local out_root="$4"
  local arena_radius="$5"
  local effective_dynamics="$6"
  local common_args=()

  build_common_args_for_suite "${arena_radius}" "${effective_dynamics}" common_args

  echo "[run_eval_kf_sequence_all] Starting ${run_dir} :: ${case_name} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --policy_role def \
    --opponent_source rule \
    --out_dir "${run_dir}/${out_root}/${case_name}" \
    "${common_args[@]}"
}

run_distance_suite() {
  local suite_label="$1"
  local out_root_base="$2"
  local arena_radius="$3"
  local run_dir="$4"
  local effective_dynamics="$5"
  local out_dir_suffix=""
  local out_root=""

  if [[ -n "${OUT_DIR_SUFFIX}" ]]; then
    out_dir_suffix="${OUT_DIR_SUFFIX}"
  else
    out_dir_suffix="$(auto_suffix_for_dynamics "${effective_dynamics}")"
  fi
  out_root="${out_root_base}${out_dir_suffix}"

  echo "[run_eval_kf_sequence_all] Queueing ${run_dir} suite=${suite_label} dynamics=$(format_dynamics_label "${effective_dynamics}") out_root=${out_root}"

  # run_rule_case "${run_dir}" "def0_vs_rule_attacker" "def0_teacher.pt" "${out_root}" "${arena_radius}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def0_vs_att1" "def0_teacher.pt" "att1_teacher.pt" "${out_root}" "${arena_radius}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def1_vs_att1" "def1_teacher.pt" "att1_teacher.pt" "${out_root}" "${arena_radius}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def1_vs_att2" "def1_teacher.pt" "att2_teacher.pt" "${out_root}" "${arena_radius}" "${effective_dynamics}"
  run_policy_case "${run_dir}" "def2_vs_att2" "def2_teacher.pt" "att2_teacher.pt" "${out_root}" "${arena_radius}" "${effective_dynamics}"
}

if [[ -n "${DYNAMICS_OVERRIDE}" ]]; then
  echo "[run_eval_kf_sequence_all] DYNAMICS_OVERRIDE=${DYNAMICS_OVERRIDE} will override any per-policy dynamics specs"
fi

for run_spec in "${RUN_SPECS[@]}"; do
  parse_run_spec "${run_spec}" run_dir run_dyn
  effective_dynamics="$(resolve_effective_dynamics "${run_dyn}" "${DYNAMICS_OVERRIDE}" "${COMMON_ARGS_DYNAMICS}")"

  run_distance_suite "20m" "MC_eval_20m" "20.0" "${run_dir}" "${effective_dynamics}"
  run_distance_suite "50m" "MC_eval_50m" "50.0" "${run_dir}" "${effective_dynamics}"
  run_distance_suite "100m" "MC_eval_100m" "100.0" "${run_dir}" "${effective_dynamics}"
done

echo "[run_eval_kf_sequence_all] Done"
