#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

DEFAULT_RUN_DIRS=(
  "Training_Policy_0.1u_1vmax"
  "Training_Policy_0.1u_1vmax_0kdock"

  "Training_Policy_0.5u_1.5vmax"
  "Training_Policy_0.5u_1.5vmax_0.25_ic"

  "Training_Policy_2.0u_1.5vmax_0kdock"
  "Training_Policy_2.0u_1vmax"
)

if (($# > 0)); then
  RUN_DIRS=("$@")
else
  RUN_DIRS=("${DEFAULT_RUN_DIRS[@]}")
fi

DYNAMICS_OVERRIDE="${DYNAMICS_OVERRIDE:-}"
OUT_DIR_SUFFIX="${OUT_DIR_SUFFIX:-}"

COMMON_ARGS=(
  --auto_shell_grid
  --grid_mode cartesian
  --index 15000
  --shell_fracs 0.2,0.4,0.6,0.8
  --arena_radius 100.0
  --def_shell_radius 20
  --att_shell_radius 100
  --velocity_dispersion_std 0.5
  --steps 6000
  --points_per_shell 40
  --velocity_controller_enabled true
  # Use the saved training/default rollout speed cap from run_manifest.json.
  --advantage_scale 1.0
  --save_rollout_error_cases
  # --device cpu
  --device cuda
)

if [[ -n "${DYNAMICS_OVERRIDE}" ]]; then
  COMMON_ARGS+=(--dynamics "${DYNAMICS_OVERRIDE}")
fi

EFFECTIVE_DYNAMICS="${DYNAMICS_OVERRIDE}"
if [[ -z "${EFFECTIVE_DYNAMICS}" ]]; then
  for ((i=0; i<${#COMMON_ARGS[@]}; i++)); do
    arg="${COMMON_ARGS[i]}"
    if [[ "${arg}" == "--dynamics" && $((i+1)) -lt ${#COMMON_ARGS[@]} ]]; then
      EFFECTIVE_DYNAMICS="${COMMON_ARGS[i+1]}"
      break
    fi
    if [[ "${arg}" == --dynamics=* ]]; then
      EFFECTIVE_DYNAMICS="${arg#--dynamics=}"
      break
    fi
  done
fi

if [[ -z "${OUT_DIR_SUFFIX}" && -n "${EFFECTIVE_DYNAMICS}" ]]; then
  OUT_DIR_SUFFIX="_${EFFECTIVE_DYNAMICS}"
fi
OUT_ROOT="MC_eval_100m_with_advantage${OUT_DIR_SUFFIX}"

run_policy_case() {
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"
  local att_ckpt="$4"

  echo "[run_eval_100m_advantage_sequence_all] Starting ${run_dir} :: ${case_name}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --att_ckpt_path "${run_dir}/${att_ckpt}" \
    --out_dir "${run_dir}/${OUT_ROOT}/${case_name}" \
    "${COMMON_ARGS[@]}"
}

run_rule_case() {
  local run_dir="$1"
  local case_name="$2"
  local def_ckpt="$3"

  echo "[run_eval_100m_advantage_sequence_all] Starting ${run_dir} :: ${case_name}"
  python evaluate_policy.py \
    --run_dir "${run_dir}" \
    --def_ckpt_path "${run_dir}/${def_ckpt}" \
    --policy_role def \
    --opponent_source rule \
    --out_dir "${run_dir}/${OUT_ROOT}/${case_name}" \
    "${COMMON_ARGS[@]}"
}

echo "[run_eval_100m_advantage_sequence_all] out_root=${OUT_ROOT} dynamics=${EFFECTIVE_DYNAMICS:-hcw(default)}"

for run_dir in "${RUN_DIRS[@]}"; do
  # run_rule_case "${run_dir}" "def0_vs_rule_attacker" "def0_teacher.pt"
  run_policy_case "${run_dir}" "def0_vs_att1" "def0_teacher.pt" "att1_teacher.pt"
  run_policy_case "${run_dir}" "def1_vs_att1" "def1_teacher.pt" "att1_teacher.pt"
  run_policy_case "${run_dir}" "def1_vs_att2" "def1_teacher.pt" "att2_teacher.pt"
  run_policy_case "${run_dir}" "def2_vs_att2" "def2_teacher.pt" "att2_teacher.pt"
done

echo "[run_eval_100m_advantage_sequence_all] Done"
